# 所有配置仅服务端；禁止添加 NEXT_PUBLIC_ 前缀或提交真实联系方式。
# live 无网络时不会回退为固定演示数据；fixture 仅允许非 production。
HIKARI_SOURCE_MODE=live
HIKARI_GFS_ENABLED=true
HIKARI_MET_ENABLED=true
HIKARI_CAMS_ENABLED=true
# ECMWF IFS 9km 日落方向空间云场；免费接口无需密钥，非商业用途及额度条款仍适用。
HIKARI_SUNSET_ENABLED=true
# 缺少真实且可联系的项目标识时 MET disabled；不要复制虚构身份。
MET_NO_USER_AGENT=
# 默认关闭；postgres 使用已迁移的本地 PostgreSQL，vercel 需完成真实平台验证。
HIKARI_SOURCE_CACHE=disabled
# 只有部署者完成真实平台跨实例缓存/SDK降级验证后才声明 true；不是自动探测。
HIKARI_SHARED_CACHE_VERIFIED=false
# vercel 模式还要求平台提供 VERCEL=1、VERCEL_PROJECT_ID、VERCEL_ENV=preview|production。
# 不在此处伪造平台环境；运行使用可能计费，启用前确认套餐、预算及发布门禁。

# 账户、AI摄影建议及可选PostgreSQL来源缓存；未配置数据库时普通天气照常可读，私人功能返回503。
HIKARI_DATABASE_URL=
# 仅迁移／测试时指定独立临时库；测试禁止回退使用上面的库。
HIKARI_TEST_DATABASE_URL=
# JSON对象，key-id -> base64编码的32字节随机密钥；首项加密，旧项保留用于轮换解密。
# 使用 node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))' 在本地生成；不要提交实际值。
HIKARI_CREDENTIAL_KEYS=
# 完整同源地址，不带末尾斜线；生产必须显式配置。
HIKARI_APP_ORIGIN=http://localhost:3000
